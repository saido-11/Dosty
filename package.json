{
  "name": "dosty",
  "productName": "Dosty",
  "version": "0.1.3-game-test.1",
  "description": "Kendi karakter görsellerinizi klavye ve fare hareketleriyle masaüstünde canlandıran çevrimdışı masaüstü uygulaması",
  "main": "src/main/main.js",
  "author": "Project Owner",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/build-native.mjs --if-supported",
    "build:native": "node scripts/build-native.mjs",
    "generate:assets": "node scripts/generate-sample-assets.mjs --legacy-samples",
    "start": "node scripts/build-native.mjs --if-supported && node scripts/launch-electron.mjs .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/build-native.mjs --if-supported && node scripts/run-e2e.mjs",
    "test:packaged:win": "node scripts/smoke-windows.mjs",
    "pack:dir": "node scripts/build-native.mjs && electron-builder --dir",
    "dist:mac": "node scripts/build-native.mjs && electron-builder --mac --arm64",
    "dist:win": "node scripts/build-native.mjs && electron-builder --win --x64",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "build": {
    "appId": "com.masaustukarakter.app",
    "productName": "Dosty",
    "asar": true,
    "npmRebuild": false,
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/characters",
        "to": "characters"
      },
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "resources/icons/app-icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false,
      "binaries": [
        "Contents/Resources/bin/input-bridge-macos"
      ]
    },
    "win": {
      "icon": "resources/icons/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  },
  "license": "GPL-3.0-only",
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
